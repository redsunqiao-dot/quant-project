{
  "version": "0.2.0",
  "paths": {
    "data_dir": "./data",
    "factor_root": "./factors",
    "composite_universe": "factors/composite_universe_st.json",
    "composite_name": "composite_st",
    "outputs_dir": "./outputs",
    "log_dir": "./outputs/logs",
    "live_dir": "./outputs/live_st",
    "paper_dir": "./outputs/paper_st"
  },
  "pipeline": {
    "lookback_days": 60,
    "composite_name": "composite_st",
    "weight_method": "ic_ir",
    "use_family_weights": false,
    "use_active_state": false,
    "active_window": 20,
    "active_min_ir": 0.1,
    "use_rolling_weights": false,
    "rolling_lookback": 60,
    "rolling_min_history": 20
  },
  "backtest": {
    "strategy": "composite_st",
    "top_n": 2,
    "capital": 50000.0,
    "rebalance": 2,
    "period": 20,
    "commission_rate": 0.00012,
    "slippage_rate": 0.001,
    "stamp_duty": 0.0005,
    "transfer_fee_rate": 1e-05,
    "risk_free_rate": 0.03
  },
  "live": {
    "strategy": "composite_st",
    "top_n": 2,
    "capital": 50000.0,
    "lot_size": 100
  },
  "paper": {
    "run_pipeline": true,
    "run_live": true,
    "pipeline_lookback_days": 60,
    "research_output_dir": "./outputs/factor_research_st",
    "note": "短窗轨：lookback=60 → composite_st；冻结名单 composite_universe_st；默认 Top2 / 每2日调仓"
  },
  "logging": {
    "level": "INFO",
    "console": true,
    "file": true,
    "format": "%(asctime)s | %(levelname)-7s | %(name)s | %(message)s",
    "datefmt": "%Y-%m-%d %H:%M:%S"
  }
}
